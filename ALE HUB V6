-- ================= SCRIPT PRINCIPAL =================
startMainExperience = function()
    local Controls = nil
    pcall(function()
        Controls = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
    end)

    local introFinished = false

    local initialJoinTime = workspace.DistributedGameTime
    local pausedTotalTime = 0
    local lastPauseStart = 0
    local isPaused = false
    local timerRemoved = false

    local TimerGui = nil
    local TimerButton = nil

    local function createTimerGui()
        if TimerGui or timerRemoved then return end

        TimerGui = Instance.new("ScreenGui")
        TimerGui.Name = "AleHubPlaytimeTimer"
        TimerGui.IgnoreGuiInset = true
        TimerGui.Enabled = introFinished
        TimerGui.Parent = CoreGui

        TimerButton = Instance.new("TextButton")
        TimerButton.Size = UDim2.new(0, 110, 0, 30)
        TimerButton.Position = UDim2.new(1, -125, 0, 15)
        TimerButton.BackgroundTransparency = 0.3
        TimerButton.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
        TimerButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        TimerButton.TextSize = 13
        TimerButton.Font = Enum.Font.GothamBold
        TimerButton.Text = "⏱️ 00:00"
        TimerButton.Parent = TimerGui

        local TimerCorner = Instance.new("UICorner")
        TimerCorner.CornerRadius = UDim.new(0, 6)
        TimerCorner.Parent = TimerButton

        local BigTimerGui = nil
        TimerButton.MouseButton1Click:Connect(function()
            if BigTimerGui then return end

            BigTimerGui = Instance.new("ScreenGui")
            BigTimerGui.Name = "AleHubBigTimer"
            BigTimerGui.IgnoreGuiInset = true
            BigTimerGui.Parent = CoreGui

            local MainFrame = Instance.new("Frame")
            MainFrame.Size = UDim2.new(0, 320, 0, 220)
            MainFrame.Position = UDim2.new(0.5, -160, 0.5, -110)
            MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
            MainFrame.BorderSizePixel = 0
            MainFrame.Active = true
            MainFrame.Draggable = true
            MainFrame.Parent = BigTimerGui

            local MainCorner = Instance.new("UICorner")
            MainCorner.CornerRadius = UDim.new(0, 10)
            MainCorner.Parent = MainFrame

            local TopBar = Instance.new("Frame")
            TopBar.Size = UDim2.new(1, 0, 0, 35)
            TopBar.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
            TopBar.BorderSizePixel = 0
            TopBar.Parent = MainFrame

            local TopCorner = Instance.new("UICorner")
            TopCorner.CornerRadius = UDim.new(0, 10)
            TopCorner.Parent = TopBar

            local TitleLabel = Instance.new("TextLabel")
            TitleLabel.Size = UDim2.new(1, -40, 1, 0)
            TitleLabel.Position = UDim2.new(0, 10, 0, 0)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.Text = "Tiempo Jugado"
            TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            TitleLabel.TextSize = 14
            TitleLabel.Font = Enum.Font.GothamBold
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
            TitleLabel.Parent = TopBar

            local CloseBigBtn = Instance.new("TextButton")
            CloseBigBtn.Size = UDim2.new(0, 35, 0, 35)
            CloseBigBtn.Position = UDim2.new(1, -35, 0, 0)
            CloseBigBtn.BackgroundTransparency = 1
            CloseBigBtn.Text = "X"
            CloseBigBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
            CloseBigBtn.TextSize = 16
            CloseBigBtn.Font = Enum.Font.GothamBold
            CloseBigBtn.Parent = TopBar

            CloseBigBtn.MouseButton1Click:Connect(function()
                if BigTimerGui then
                    BigTimerGui:Destroy()
                    BigTimerGui = nil
                end
            end)

            local BigDisplay = Instance.new("TextLabel")
            BigDisplay.Size = UDim2.new(1, -40, 0, 60)
            BigDisplay.Position = UDim2.new(0, 20, 0, 50)
            BigDisplay.BackgroundTransparency = 1
            BigDisplay.TextColor3 = Color3.fromRGB(255, 255, 255)
            BigDisplay.TextSize = 36
            BigDisplay.Font = Enum.Font.GothamBold
            BigDisplay.Parent = MainFrame

            local function getSecondsElapsed()
                if isPaused then
                    return math.floor(lastPauseStart - initialJoinTime - pausedTotalTime)
                else
                    return math.floor(workspace.DistributedGameTime - initialJoinTime - pausedTotalTime)
                end
            end

            local function updateBigDisplay()
                local currentSeconds = math.max(0, getSecondsElapsed())
                local minutes = math.floor(currentSeconds / 60)
                local seconds = currentSeconds % 60
                BigDisplay.Text = string.format("%02d:%02d", minutes, seconds)
            end
            updateBigDisplay()

            task.spawn(function()
                while BigTimerGui and BigTimerGui.Parent do
                    updateBigDisplay()
                    task.wait(1)
                end
            end)

            local PauseBtn = Instance.new("TextButton")
            PauseBtn.Size = UDim2.new(1, -40, 0, 38)
            PauseBtn.Position = UDim2.new(0, 20, 0, 120)
            PauseBtn.BackgroundColor3 = isPaused and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(120, 100, 0)
            PauseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            PauseBtn.Text = isPaused and "Reanudar Temporizador" or "Pausar Temporizador"
            PauseBtn.TextSize = 13
            PauseBtn.Font = Enum.Font.GothamBold
            PauseBtn.Parent = MainFrame

            local PauseCorner = Instance.new("UICorner")
            PauseCorner.CornerRadius = UDim.new(0, 6)
            PauseCorner.Parent = PauseBtn

            PauseBtn.MouseButton1Click:Connect(function()
                if not isPaused then
                    isPaused = true
                    lastPauseStart = workspace.DistributedGameTime
                    PauseBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
                    PauseBtn.Text = "Reanudar Temporizador"
                else
                    pausedTotalTime = pausedTotalTime + (workspace.DistributedGameTime - lastPauseStart)
                    isPaused = false
                    PauseBtn.BackgroundColor3 = Color3.fromRGB(120, 100, 0)
                    PauseBtn.Text = "Pausar Temporizador"
                end
            end)

            local RemoveBtn = Instance.new("TextButton")
            RemoveBtn.Size = UDim2.new(1, -40, 0, 38)
            RemoveBtn.Position = UDim2.new(0, 20, 0, 168)
            RemoveBtn.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
            RemoveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            RemoveBtn.Text = "Quitar Temporizador"
            RemoveBtn.TextSize = 13
            RemoveBtn.Font = Enum.Font.GothamBold
            RemoveBtn.Parent = MainFrame

            local RemoveCorner = Instance.new("UICorner")
            RemoveCorner.CornerRadius = UDim.new(0, 6)
            RemoveCorner.Parent = RemoveBtn

            RemoveBtn.MouseButton1Click:Connect(function()
                timerRemoved = true
                if BigTimerGui then
                    BigTimerGui:Destroy()
                    BigTimerGui = nil
                end
                if TimerGui then
                    TimerGui:Destroy()
                    TimerGui = nil
                end
            end)
        end)
    end

    createTimerGui()

    task.spawn(function()
        while true do
            task.wait(1)
            if TimerButton and TimerButton.Parent then
                local currentSeconds
                if isPaused then
                    currentSeconds = math.floor(lastPauseStart - initialJoinTime - pausedTotalTime)
                else
                    currentSeconds = math.floor(workspace.DistributedGameTime - initialJoinTime - pausedTotalTime)
                end
                currentSeconds = math.max(0, currentSeconds)
                local minutes = math.floor(currentSeconds / 60)
                local seconds = currentSeconds % 60
                TimerButton.Text = string.format("⏱️ %02d:%02d%s", minutes, seconds, isPaused and " (P.)" or "")
            end
        end
    end)

    -- Pantalla de Carga
    local IntroGui = Instance.new("ScreenGui")
    IntroGui.Name = "HalloweenIntro"
    IntroGui.IgnoreGuiInset = true
    IntroGui.Parent = CoreGui

    local Background = Instance.new("ImageLabel")
    Background.Size = UDim2.new(1, 0, 1, 0)
    Background.BackgroundTransparency = 1
    Background.Image = "rbxassetid://138097070120423"
    Background.ScaleType = Enum.ScaleType.Slice
    Background.Parent = IntroGui

    local PumpkinContainer = Instance.new("Folder")
    PumpkinContainer.Name = "Pumpkins"
    PumpkinContainer.Parent = Background

    local pumpkinSymbols = {"🎃", "🦇", "👻"}

    for i = 1, 20 do
        task.spawn(function()
            local pumpkin = Instance.new("TextLabel")
            pumpkin.Size = UDim2.new(0, 50, 0, 50)
            pumpkin.BackgroundTransparency = 1
            pumpkin.Text = pumpkinSymbols[math.random(1, #pumpkinSymbols)]
            pumpkin.TextSize = math.random(25, 45)
            pumpkin.Parent = PumpkinContainer

            while IntroGui.Parent and not introFinished do
                local startX = math.random(5, 95) / 100
                pumpkin.Position = UDim2.new(startX, 0, 1.1, 0)
                pumpkin.TextTransparency = 0
                
                local speed = math.random(4, 8)
                local tweenInfo = TweenInfo.new(speed, Enum.EasingStyle.Linear)
                
                local tw = TweenService:Create(pumpkin, tweenInfo, {
                    Position = UDim2.new(startX + math.random(-5, 5)/100, 0, -0.1, 0)
                })
                
                tw:Play()
                tw.Completed:Wait()
            end
            pumpkin:Destroy()
        end)
    end

    local TerrorText = Instance.new("TextLabel")
    TerrorText.Size = UDim2.new(1, 0, 0, 100)
    TerrorText.Position = UDim2.new(0, 0, 0.45, -50)
    TerrorText.BackgroundTransparency = 1
    TerrorText.Text = "BIENVENID@"
    TerrorText.TextSize = 65
    TerrorText.Font = Enum.Font.Creepster
    TerrorText.TextColor3 = Color3.fromRGB(255, 255, 255)
    TerrorText.TextStrokeTransparency = 0
    TerrorText.TextStrokeColor3 = Color3.fromRGB(180, 0, 0)
    TerrorText.Parent = Background

    local IntroSound = Instance.new("Sound")
    IntroSound.SoundId = "rbxassetid://95028776242006"
    IntroSound.Volume = 2
    IntroSound.Parent = SoundService
    IntroSound.TimePosition = 7
    pcall(function() IntroSound:Play() end)

    task.spawn(function()
        local connection
        local fadingOut = false
        
        connection = RunService.RenderStepped:Connect(function()
            local currentTime = IntroSound.TimePosition
            
            if not fadingOut then
                local hue = tick() % 5 / 5
                TerrorText.TextColor3 = Color3.fromHSV(hue, 1, 1)
            end
            
            if (currentTime >= 13 or not IntroSound.IsPlaying) and not fadingOut then
                fadingOut = true
                local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                
                local bgTween = TweenService:Create(Background, tweenInfo, {ImageTransparency = 1})
                local textTween = TweenService:Create(TerrorText, tweenInfo, {TextTransparency = 1, TextStrokeTransparency = 1})
                
                bgTween:Play()
                textTween:Play()
                
                for _, pumpkin in ipairs(PumpkinContainer:GetChildren()) do
                    if pumpkin:IsA("TextLabel") then
                        TweenService:Create(pumpkin, tweenInfo, {TextTransparency = 1}):Play()
                    end
                end
                
                pcall(function() IntroSound:Stop() end)
                
                task.delay(1.2, function()
                    introFinished = true
                    if TimerGui then
                        TimerGui.Enabled = true
                    end
                    pcall(function()
                        IntroSound:Destroy()
                        IntroGui:Destroy()
                    end)
                end)
                
                connection:Disconnect()
            end
        end)
    end)

    -- Carga de WindUI
    local successLoad, WindUI = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/refs/heads/main/dist/main.lua"))()
    end)

    if not successLoad or not WindUI then
        warn("No se pudo cargar WindUI. Revisa tu ejecutor.")
        return
    end

    local Window = Window or WindUI:CreateWindow({
        Title = "ALE HUB",
        Icon = "monitor",
        Author = "V1.0",
        Folder = "MiMenuWindUI",
        Size = UDim2.fromOffset(580, 460),
        KeySystem = false,
    })

    -- ================= PESTAÑA CONFIGURACIÓN =================
    local ConfigTab = Window:Tab({
        Title = "Configuración",
        Icon = "settings",
    })

    ConfigTab:Toggle({
        Title = "Modo Oscuro / Claro (Theme)",
        Description = "Cambia el estilo visual del menú entre oscuro o claro.",
        Value = true,
        Callback = function(state)
            if not introFinished then return end
            WindUI:SetTheme(state and "Dark" or "Light")
        end,
    })

    ConfigTab:Button({
        Title = "Volver a poner temporizador",
        Description = "Vuelve a mostrar el temporizador flotante en pantalla con el tiempo real acumulado.",
        Callback = function()
            timerRemoved = false
            createTimerGui()
        end,
    })

    ConfigTab:Button({
        Title = "Copiar ID del Servidor (JobId)",
        Description = "Copia el código único de este servidor al portapapeles.",
        Callback = function()
            pcall(function()
                if setclipboard then
                    setclipboard(game.JobId)
                end
            end)
        end,
    })

    ConfigTab:Button({
        Title = "Reconectar Servidor (Rejoin)",
        Description = "Te reconecta automáticamente al mismo juego.",
        Callback = function()
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end)
        end,
    })

    ConfigTab:Button({
        Title = "Optimización (FPS Boost)",
        Description = "Desactiva sombras y niebla para mejorar el rendimiento.",
        Callback = function()
            pcall(function()
                Lighting.GlobalShadows = false
                Lighting.FogEnd = 999999
                for _, v in ipairs(Lighting:GetChildren()) do
                    if v:IsA("PostEffect") then
                        v.Enabled = false
                    end
                end
            end)
        end,
    })

    ConfigTab:Button({
        Title = "Fluidez Máxima (Antitrabas / FPS Boost)",
        Description = "Desactiva efectos pesados, texturas detalladas y baja la calidad para que no se trabe nada.",
        Callback = function()
            pcall(function()
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                Lighting.GlobalShadows = false
                Lighting.FogEnd = 999999
                Lighting.Brightness = 2
                for _, v in ipairs(Lighting:GetChildren()) do
                    if v:IsA("PostEffect") or v:IsA("Sky") then
                        v.Enabled = false
                    end
                end
                
                for _, part in ipairs(workspace:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Material = Enum.Material.SmoothPlastic
                        part.Reflectance = 0
                    elseif part:IsA("Decal") or part:IsA("Texture") then
                        part.Transparency = 1
                    elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Fire") or part:IsA("Smoke") or part:IsA("Sparkles") then
                        part.Enabled = false
                    end
                end
                
                WindUI:Notify({
                    Title = "Fluidez Activada",
                    Content = "¡Gráficos y efectos optimizados para máxima velocidad!",
                    Duration = 4,
                })
            end)
        end,
    })

    ConfigTab:Button({
        Title = "Reiniciar Personaje",
        Description = "Te mata y respawnea instantáneamente si te quedas trabado.",
        Callback = function()
            local character = LocalPlayer.Character
            if character and character:FindFirstChildOfClass("Humanoid") then
                character:FindFirstChildOfClass("Humanoid").Health = 0
            end
        end,
    })

    local menuVisible = true

    local function ToggleMenu()
        menuVisible = not menuVisible
        
        pcall(function()
            for _, gui in ipairs(CoreGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name ~= "HalloweenIntro" and gui.Name ~= "AleHubPlaytimeTimer" and gui.Name ~= "AleHubBigTimer" then
                    if gui:FindFirstChild("Frame") or gui:FindFirstChild("Container") then
                        gui.Enabled = menuVisible
                    end
                end
            end
        end)
    end

    ConfigTab:Button({
        Title = "Ocultar / Mostrar Menú",
        Description = "Oculta el menú visualmente en tu pantalla. (Solo para PC, computadora)",
        Callback = function()
            ToggleMenu()
