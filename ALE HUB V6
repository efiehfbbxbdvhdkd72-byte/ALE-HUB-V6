    local function refreshAllLists()
        local newList = getUpdatedPlayerList()
        
        pcall(function()
            teleportDropdown:Values(newList)
            spectateDropdown:Values(newList)
            followDropdown:Values(newList)
        end)
        
        if selectedPlayerName and not Players:FindFirstChild(selectedPlayerName) then
            selectedPlayerName = nil
        end
        if spectatePlayerName and not Players:FindFirstChild(spectatePlayerName) then
            spectatePlayerName = nil
        end
        if followPlayerName and not Players:FindFirstChild(followPlayerName) then
            followPlayerName = nil
            FollowEnabled = false
        end
    end

