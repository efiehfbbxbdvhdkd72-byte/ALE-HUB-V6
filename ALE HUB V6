    local function getAIResponse(question)
        local q = string.lower(question)
        
        if string.find(q, "creó") or string.find(q, "creador") or string.find(q, "id") or string.find(q, "quien te hizo") or string.find(q, "quien te programó") then
            return "[COLOR_RED]No puedo decir quién me creó, porque es privado."
        end

        if string.find(q, "persona más inteligente") or string.find(q, "mas inteligente del mundo") then
            return "Actualmente, la persona viva con el coeficiente intelectual (IQ) más alto comprobado de manera oficial es Marilyn vos Savant, aunque a lo largo de la historia genios como Albert Einstein o Stephen Hawking han sido considerados los más inteligentes del mundo."
        elseif string.find(q, "fede") or string.find(q, "vigevani") then
            return "Fede Vigevani (Federico Augusto Vigevani de Arce) es un famoso creador de contenido, influencer y músico uruguayo nacido el 1 de octubre de 1994. Actualmente tiene 31 años, es muy conocido por sus retos extremos, videos de terror con 'La Vecibanda' y su gran éxito en internet."
        elseif string.find(q, "huesos") and (string.find(q, "cuerpo") or string.find(q, "humano")) then
            return "El cuerpo humano de un adulto tiene exactamente 206 huesos, los cuales forman el esqueleto para dar soporte, protección y permitir el movimiento."
        elseif string.find(q, "google") then
            return "Google es una multinacional tecnológica estadounidense especializada en productos y servicios relacionados con internet, software, dispositivos electrónicos y otras tecnologías."
        elseif string.find(q, "hola") or string.find(q, "saludos") or string.find(q, "buenas") then
            return "¡Hola! Soy ALE AI, tu asistente inteligente universal. Estoy programada para responderte de forma completa sobre cualquier tema de ciencia, historia, tecnología, cultura o entretenimiento. ¿Qué te gustaría consultar hoy?"
        elseif string.find(q, "tu nombre") or string.find(q, "quien eres") then
            return "Soy ALE AI, una inteligencia artificial avanzada diseñada para ayudarte, analizar cualquier clase de información y conversar sobre cualquier tema de interés dentro de este script de Roblox."
        elseif string.find(q, "roblox") then
            return "Roblox es una plataforma de experiencias en línea y un sistema de creación de juegos donde los usuarios pueden programar y jugar mundos virtuales creados por otros."
        elseif string.find(q, "capital de mexico") or string.find(q, "capital de méxico") then
            return "La capital de México es la Ciudad de México (CDMX), una de las metrópolis más grandes, culturales e importantes del mundo."
        elseif string.find(q, "cielo") and string.find(q, "azul") then
            return "El cielo se ve azul debido a un fenómeno llamado dispersión de Rayleigh. La luz del Sol llega a la atmósfera y las moléculas de aire dispersan la luz azul en todas direcciones más que los otros colores."
        elseif string.find(q, "perro") or string.find(q, "perros") then
            return "Los perros son mamíferos domésticos de la familia de los cánidos, conocidos popularmente como 'el mejor amigo del hombre' por su lealtad, inteligencia y compañía."
        elseif string.find(q, "gato") or string.find(q, "gatos") then
            return "Los gatos son pequeños mamíferos carnívoros domesticados, muy valorados por su agilidad, independencia y naturaleza cazadora."
        elseif string.find(q, "javascript") or string.find(q, "lua") or string.find(q, "programar") then
            return "La programación es el proceso de diseñar y construir un conjunto de instrucciones escritas (código) para que una computadora realice tareas específicas, ¡exactamente como los scripts de Roblox en Lua!"
        elseif string.find(q, "amor") then
            return "El amor es un conjunto de sentimientos y actitudes relacionados con el afecto, la unión y el cuidado profundo hacia otras personas, familiares o seres vivos."
        elseif string.find(q, "universo") or string.find(q, "espacio") or string.find(q, "estrellas") then
            return "El universo es la totalidad de todo lo que existe: espacio, tiempo, materia, energía, planetas, galaxias y leyes físicas. Su origen se explica generalmente a través de la teoría del Big Bang."
        elseif string.find(q, "historia") or string.find(q, "guerra") then
            return "La historia es la disciplina que estudia los acontecimientos del pasado protagonizados por la humanidad, permitiéndonos comprender nuestro presente y evolución cultural."
        elseif string.find(q, "musica") or string.find(q, "cancion") then
            return "La música es el arte de organizar de manera sensible y coherente una combinación de sonidos y silencios utilizando los principios fundamentales de la melodía, la armonía y el ritmo."
        elseif string.find(q, "deporte") or string.find(q, "futbol") then
            return "El deporte abarca todas aquellas actividades físicas que involucran reglas competitivas, destreza y entrenamiento corporal, siendo el fútbol uno de los más practicados a nivel global."
        else
            return "Respecto à '" .. question .. "', es un tema sumamente amplio e interesante. Analizándolo desde un enfoque general, abarca conceptos profundos relacionados con la ciencia, el análisis crítico o el conocimiento humano. Cada aspecto de esta cuestión ofrece múltiples perspectivas dignas de estudio y debate detallado."
